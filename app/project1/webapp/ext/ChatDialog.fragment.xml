<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="chatDialogControl"
        title="Ask the Catalog"
        contentWidth="28rem"
        contentHeight="32rem">
        <content>
            <List id="chatMessageList" items="{chat>/messages}">
                <StandardListItem
                    title="{chat>content}"
                    description="{chat>role}" />
            </List>
        </content>
        <beginButton>
            <Button text="Close" press=".onCloseChat" />
        </beginButton>
        <footer>
            <Toolbar>
                <Input id="chatInput" placeholder="Type a message..." submit=".onSend" />
                <Button icon="sap-icon://paper-plane" press=".onSend" />
            </Toolbar>
        </footer>
    </Dialog>
</core:FragmentDefinition>